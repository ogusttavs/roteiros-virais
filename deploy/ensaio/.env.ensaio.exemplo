# Copie para .env.ensaio (mesma pasta) antes de rodar deploy/ensaio/ensaiar.sh.
# So segredo de teste aqui, nunca os reais; este arquivo nunca sobe para a
# VPS (README.md, "O que nunca fazer"). .env.ensaio fica de fora do git
# (.gitignore); so este .exemplo entra.

APP_NAME="seu painel (ensaio)"
APP_URL=http://127.0.0.1:3500
BETTER_AUTH_URL=http://127.0.0.1:3500

# A mesma senha nos dois (compose.prod.yml, comentario do roteiros-postgres).
# 32 caracteres ou mais, do jeito que o ensaiar.sh confere antes de comecar.
POSTGRES_PASSWORD=ensaio-troque-esta-senha-de-teste-000
DATABASE_URL=postgres://roteiros:ensaio-troque-esta-senha-de-teste-000@roteiros-postgres:5432/roteiros

# 32 caracteres ou mais (verificarSegredosDeProducao, src/lib/config.ts,
# recusa iniciar em NODE_ENV=production com o valor de exemplo do
# .env.example; o container roda sempre em producao).
BETTER_AUTH_SECRET=ensaio-segredo-de-teste-com-32-caracteres-ou-mais
JOBS_API_KEY=ensaio-chave-de-jobs-de-teste-com-32-caracteres

# Mock: sem chamada de IA de verdade no ensaio (decisao 3 desta parte).
AI_PROVIDER=mock

# Vazio de proposito (decisao 1 desta parte): sem conta do Sentry nem bucket
# externo so para o ensaio local.
SENTRY_DSN=
BACKUP_RCLONE_REMOTE=
