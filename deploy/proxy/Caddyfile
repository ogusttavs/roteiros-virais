# Caddyfile compartilhado (/srv/proxy/Caddyfile). Um bloco por produto, marcado
# com o nome. Ninguem edita o bloco do outro. Validar antes de recarregar.
#
# Editar so por redirecionamento no mesmo arquivo, nunca sed -i: o container
# monta este arquivo como bind mount unico, e sed -i troca o inode, entao
# validate/reload continuam lendo a versao antiga sem erro nenhum
# (deploy/README.md, "Editar o Caddyfile compartilhado").
#
# O e-mail abaixo precisa ter dominio de verdade: admin@localhost e recusado
# pelo Let's Encrypt e pelo ZeroSSL ("Domain name needs at least one dot").

{
	email {$CADDY_EMAIL:gustavs.silvs@gmail.com}
}

# roteiros: o endereco antigo leva para o novo (22/10/2026)
app.srv1953618.hstgr.cloud {
	redir https://klaki.getorbita.com.br{uri} permanent
}

# roteiros, endereco provisorio com dominio proprio (22/10/2026, decisao do Gustavo)
klaki.getorbita.com.br {
	encode zstd gzip
	# 26/11/2026 (T97, auditoria de seguranca A1 e M1): o app nao usa next/image, entao a rota
	# do otimizador de imagem some no proxy; e cabecalhos de seguranca basicos.
	@otimizadorImagem path /_next/image /_next/image/*
	respond @otimizadorImagem 404
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}
	reverse_proxy roteiros-app:3000
}

# odontotech
# 22/10/2026: dominio proprio odontotech.app (F10.7-f-dominio). O endereco antigo segue servindo
# enquanto BETTER_AUTH_URL e os webhooks da Meta e do Stripe migram.
odontotech.app {
	encode zstd gzip
	reverse_proxy odontotech-app:3000
}

www.odontotech.app {
	redir https://odontotech.app{uri} permanent
}

# Endereco antigo: os webhooks (Meta, Stripe) continuam aqui ate a URL mudar nos paineis; o resto vai
# para o dominio proprio.
odontotech.srv1953618.hstgr.cloud {
	encode zstd gzip
	@webhooks path /api/webhooks/*
	handle @webhooks {
		reverse_proxy odontotech-app:3000
	}
	handle {
		redir https://odontotech.app{uri} permanent
	}
}

# roteiros: dominio novo klaki.app (26/11/2026, pedido do Gustavo). Por enquanto so leva para o
# endereco atual, com 302 de proposito: um 301 ficaria guardado nos navegadores e daria volta
# infinita quando o klaki.app virar o endereco principal depois da reuniao de sexta.
klaki.app, www.klaki.app {
	redir https://klaki.getorbita.com.br{uri} 302
}
