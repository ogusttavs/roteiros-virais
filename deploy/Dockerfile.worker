# Dockerfile do worker (etapa 8, decisao 5 do PROXIMO.md): so o processo de
# jobs (pg-boss), nao a aplicacao web. Usado a partir da etapa 13; escrito
# agora so para existir e buildar sem erro (criterio de aceite desta etapa).
#
# yt-dlp e ffmpeg sao dependencia de sistema (nao pacote npm, ver
# HISTORICO.md), instalados aqui: ffmpeg via apt.
#
# yt-dlp por pip, com o extra `curl-cffi` (V2a, item 4, README do yt-dlp
# conferido na data, nao de memoria): o zipapp standalone que este
# Dockerfile baixava antes nunca consegue fazer impersonation de
# navegador, mesmo com curl_cffi instalado no sistema, porque o README
# lista esse binario Unix como excecao explicita ("Currently included in
# most builds except yt-dlp (Unix zipimport binary)..."). Sem
# impersonation, o TikTok falha sempre com "The extractor is attempting
# impersonation, but no impersonate target is available" (achado em
# producao, 19/09/2026). `pip install --break-system-packages` porque a
# imagem base e Debian bookworm (PEP 668, confirmado rodando node:24-slim);
# nao ha risco de "quebrar" um Python de sistema que so existe para o
# yt-dlp dentro deste container.
#
# yt-dlp em versao fixa (achado da conferencia de producao, 09/09/2026, nao
# "latest"): o build fica reproduzivel, a mesma imagem sempre traz a mesma
# versao, em vez de mudar sozinha a cada rebuild sem passar por revisao.
# Por pip isso e `pacote==versao`, mesmo ARG de antes.
#
# Deno (mesmo achado, `src/jobs/youtube-cliente.ts`): o yt-dlp exige um
# runtime de JavaScript para resolver o desafio de assinatura do YouTube, e
# o habilita sozinho, sem flag, quando acha o binario no PATH (yt-dlp wiki,
# pagina "EJS", conferida em 09/09/2026, minimo 2.3.0; esta imagem usa uma
# bem mais nova). Binario oficial da Deno Land, baixado por versao fixa e
# conferido pelo sha256sum publicado junto do release, antes de instalar.
#
# Plugin do provedor de PO Token (transcricao do YouTube, rodada 2, item 1,
# github.com/Brainicism/bgutil-ytdlp-pot-provider, versao fixa como o resto):
# entra pelo metodo "Executable location" do proprio README do yt-dlp
# ("Installing Plugins"), uma pasta `yt-dlp-plugins` do lado da "localizacao
# do executavel". Isso MUDOU de lugar com yt-dlp por pip (achado do ensaio
# desta rodada, 19/09/2026: o primeiro build passou, mas o provedor sumiu
# da lista "PO Token Providers"): o `get_executable_path()` do proprio
# yt-dlp (`yt_dlp/plugins.py`, `yt_dlp/utils/_utils.py`), que decide onde
# procurar plugins, olha o diretorio do pacote Python (`dist-packages`),
# nao o script wrapper que o pip cria em `/usr/local/bin/yt-dlp`; o zipapp
# antigo nao tinha essa distincao, o binario e o "pacote" eram a mesma
# coisa. A pasta correta agora e calculada em build, chamando a mesma
# funcao que o yt-dlp usa em runtime, em vez de supor o caminho (evita
# quebrar nesta mesma armadilha nunca mais, mesmo que a versao do Python
# do node:24-slim mude). O `.zip` do release tem `yt_dlp_plugins/` na
# propria raiz (conferido em 10/09/2026, `unzip -l` no zip baixado), que e
# a forma que o README do yt-dlp descreve como aceita direto, sem
# descompactar. O servidor do provedor (a outra metade) roda a parte, como
# o servico `roteiros-pot` do Compose.
FROM node:24-slim

ARG YT_DLP_VERSION=2026.08.19
ARG DENO_VERSION=2.9.6
ARG BGUTIL_POT_VERSION=2.0.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip ca-certificates curl unzip \
  && pip install --break-system-packages --no-cache-dir "yt-dlp[default,curl-cffi]==${YT_DLP_VERSION}" \
  && curl -fL "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" -o /tmp/deno-x86_64-unknown-linux-gnu.zip \
  && curl -fL "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip.sha256sum" -o /tmp/deno-x86_64-unknown-linux-gnu.zip.sha256sum \
  && (cd /tmp && sha256sum -c deno-x86_64-unknown-linux-gnu.zip.sha256sum) \
  && unzip -q /tmp/deno-x86_64-unknown-linux-gnu.zip -d /usr/local/bin \
  && chmod a+rx /usr/local/bin/deno \
  && rm -f /tmp/deno-x86_64-unknown-linux-gnu.zip /tmp/deno-x86_64-unknown-linux-gnu.zip.sha256sum \
  && PLUGIN_ROOT=$(python3 -c "from yt_dlp.utils import get_executable_path; print(get_executable_path())") \
  && mkdir -p "$PLUGIN_ROOT/yt-dlp-plugins" \
  && curl -fL "https://github.com/Brainicism/bgutil-ytdlp-pot-provider/releases/download/${BGUTIL_POT_VERSION}/bgutil-ytdlp-pot-provider.zip" -o "$PLUGIN_ROOT/yt-dlp-plugins/bgutil-ytdlp-pot-provider.zip" \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Sha curto do commit (etapa 13, decisao 1): vira `release` no Sentry, so
# usado em runtime (nunca num RUN de build). Fica depois das duas camadas
# caras (apt-get e npm ci) de proposito: um ARG/ENV muda a cada commit
# (achado da revisao adversarial desta etapa) e, se viesse antes, invalidava
# o cache dessas camadas em toda build, mesmo com cache-from/cache-to do
# workflow "Imagens".
ARG GIT_SHA=""
ENV GIT_SHA=$GIT_SHA

# tsx roda os jobs direto do TypeScript, sem passo de build separado (mesmo
# padrao ja usado em desenvolvimento, npm run worker).
#
# Direto no binario do tsx, nao "npm run worker" (achado do ensaio local,
# etapa 13 parte 3): "npm run <script>" passa por um "sh -c" no meio, que
# nao repassa o SIGTERM do Docker para o processo Node de verdade (o log
# so mostra "npm error signal SIGTERM", nunca o "worker recebeu SIGTERM,
# parando com graca" de src/jobs/desligamento.ts). Sem isso, todo
# `docker compose stop` (todo deploy) matava o worker no meio de um job em
# vez de deixar o pg-boss terminar sozinho, do jeito que stop_grace_period
# deste servico e TIMEOUT_DESLIGAMENTO_MS existem para permitir. Rodando o
# binario direto (exec, sem shell no meio), o processo do tsx vira o PID 1
# do container e recebe o sinal direto.
CMD ["node_modules/.bin/tsx", "src/jobs/worker.ts"]
