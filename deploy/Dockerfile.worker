# Dockerfile do worker (etapa 8, decisao 5 do PROXIMO.md): so o processo de
# jobs (pg-boss), nao a aplicacao web. Usado a partir da etapa 13; escrito
# agora so para existir e buildar sem erro (criterio de aceite desta etapa).
#
# yt-dlp e ffmpeg sao dependencia de sistema (nao pacote npm, ver
# HISTORICO.md), instalados aqui: ffmpeg via apt; yt-dlp e o zipapp
# distribuido no release oficial, que precisa de python3 no PATH (achado
# buildando esta imagem: o binario sem sufixo do release nao e standalone
# de verdade, "/usr/bin/env: python3: No such file or directory").
#
# yt-dlp em versao fixa (achado da conferencia de producao, 09/09/2026, nao
# "latest"): o build fica reproduzivel, a mesma imagem sempre traz a mesma
# versao, em vez de mudar sozinha a cada rebuild sem passar por revisao.
#
# Deno (mesmo achado, `src/jobs/youtube-cliente.ts`): o yt-dlp exige um
# runtime de JavaScript para resolver o desafio de assinatura do YouTube, e
# o habilita sozinho, sem flag, quando acha o binario no PATH (yt-dlp wiki,
# pagina "EJS", conferida em 09/09/2026, minimo 2.3.0; esta imagem usa uma
# bem mais nova). Binario oficial da Deno Land, baixado por versao fixa e
# conferido pelo sha256sum publicado junto do release, antes de instalar.
FROM node:24-slim

ARG YT_DLP_VERSION=2026.08.19
ARG DENO_VERSION=2.9.6

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 ca-certificates curl unzip \
  && curl -fL "https://github.com/yt-dlp/yt-dlp/releases/download/${YT_DLP_VERSION}/yt-dlp" -o /usr/local/bin/yt-dlp \
  && chmod a+rx /usr/local/bin/yt-dlp \
  && curl -fL "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" -o /tmp/deno-x86_64-unknown-linux-gnu.zip \
  && curl -fL "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip.sha256sum" -o /tmp/deno-x86_64-unknown-linux-gnu.zip.sha256sum \
  && (cd /tmp && sha256sum -c deno-x86_64-unknown-linux-gnu.zip.sha256sum) \
  && unzip -q /tmp/deno-x86_64-unknown-linux-gnu.zip -d /usr/local/bin \
  && chmod a+rx /usr/local/bin/deno \
  && rm -f /tmp/deno-x86_64-unknown-linux-gnu.zip /tmp/deno-x86_64-unknown-linux-gnu.zip.sha256sum \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Sha curto do commit (etapa 13, decisao 1): vira `release` no Sentry, so
# usado em runtime (nunca num RUN de build). Fica depois das duas camadas
# caras (apt-get e npm ci) de proposito: um ARG/ENV muda a cada commit
# (achado da revisao adversarial desta etapa) e, se viesse antes, invalidava
# o cache dessas camadas em toda build, mesmo com cache-from/cache-to do
# workflow "Imagens".
ARG GIT_SHA=""
ENV GIT_SHA=$GIT_SHA

# tsx roda os jobs direto do TypeScript, sem passo de build separado (mesmo
# padrao ja usado em desenvolvimento, npm run worker).
#
# Direto no binario do tsx, nao "npm run worker" (achado do ensaio local,
# etapa 13 parte 3): "npm run <script>" passa por um "sh -c" no meio, que
# nao repassa o SIGTERM do Docker para o processo Node de verdade (o log
# so mostra "npm error signal SIGTERM", nunca o "worker recebeu SIGTERM,
# parando com graca" de src/jobs/desligamento.ts). Sem isso, todo
# `docker compose stop` (todo deploy) matava o worker no meio de um job em
# vez de deixar o pg-boss terminar sozinho, do jeito que stop_grace_period
# deste servico e TIMEOUT_DESLIGAMENTO_MS existem para permitir. Rodando o
# binario direto (exec, sem shell no meio), o processo do tsx vira o PID 1
# do container e recebe o sinal direto.
CMD ["node_modules/.bin/tsx", "src/jobs/worker.ts"]
