# Copie para .env e preencha. Nunca commitar o .env.

# Nome do produto (provisorio; a identidade chega depois)
APP_NAME="Klaki"
APP_URL=http://localhost:3000

# Banco (compose.dev.yml sobe este Postgres localmente, banco "roteiros_dev")
DATABASE_URL=postgres://roteiros:roteiros@localhost:5432/roteiros_dev

# Sessao e autenticacao (better-auth). Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-em-producao
BETTER_AUTH_URL=http://localhost:3000
# MODO_E2E nunca entra aqui nem em nenhum .env de producao: so o webServer.env do playwright.config.ts a define.

# Inteligencia (SDK oficial da Anthropic). AI_PROVIDER: anthropic ou mock.
# Sem chave, cai em mock (respostas simuladas, custo zero; e o modo dos testes).
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL_FORTE=claude-opus-5
AI_MODEL_BARATO=claude-haiku-4-5

# Transcricao (Groq). Sem chave, o job de transcricao so usa legenda do YouTube.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
# Proxy do yt-dlp (preparacao da viagem, item 0): "http://usuario:senha@host:porta".
# Vazio por padrao (sem proxy). YouTube e TikTok passam por ele; o Instagram nunca usa.
YTDLP_PROXY=
# Tempo limite de UM download do yt-dlp (audio ou legenda), em segundos; passou, o processo e morto e o job segue.
YTDLP_LIMITE_S=90
# Tempo limite de UMA transcricao na Groq (as tentativas do SDK juntas), em segundos.
GROQ_LIMITE_S=60
# Orcamento do job transcrever: por setor (o que sobra fica para a noite seguinte) e no total (abaixo das 4 h em que a fila vence o job).
ORCAMENTO_TRANSCREVER_SETOR_MIN=30
ORCAMENTO_TRANSCREVER_TOTAL_MIN=210
# Quantos setores novos podem nascer por dia da escolha de um ramo do catalogo (cada um comeca uma pesquisa paga); 0 desliga o teto.
MAX_SETORES_NOVOS_POR_DIA=10

# Coleta
YOUTUBE_API_KEY=
APIFY_TOKEN=
APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
# Maximo de itens cobrados por chamada ao ator. Sem valor: 50 em desenvolvimento, 200 em producao.
APIFY_MAX_ITEMS=
# Teto diario de resultados do Apify (TikTok + Instagram somados)
APIFY_MAX_RESULTADOS_DIA=1000
# Quantos termos do setor entram na busca do pesquisa-de-setor (200 unidades do YouTube cada).
TERMOS_PESQUISA_SETOR=4
# Instagram pela API oficial da Meta (Business Discovery e Hashtag Search), em vez do Apify.
# META_TOKEN e um token permanente de usuario do sistema do Portfolio empresarial da Velura
# (acessos/meta-app.md, Passo 8 de acessos/prompt-agente-meta.md); nunca expira, nunca aparece em log.
META_ATIVO=
META_IG_ID=
META_TOKEN=

# E-mail (Resend). Em desenvolvimento, sem chave, o link magico sai no log.
RESEND_API_KEY=
EMAIL_FROM=painel@seu-dominio-provisorio.com.br
# Contato mostrado em /termos e /privacidade
EMAIL_CONTATO=contato@seu-dominio-provisorio.com.br
# Para onde vai o e-mail diario de acompanhamento da viagem, as 08:00 (V10, item 4).
# Opcional: vazio, o job nao manda nada.
EMAIL_ACOMPANHAMENTO=

# Erros e jobs
SENTRY_DSN=
JOBS_API_KEY=troque-em-producao

# Regras de produto (decisao, nao opiniao; ver CLAUDE.md e briefing-e-rubricas.md)
# Piso de views para um video virar referencia ou evidencia (decisao do Gustavo em 25/09/2026).
PISO_VIEWS_REFERENCIA=50000
# Teto de duracao, em segundos, para um video ser referencia, tema ou evidencia (o produto e video curto).
TETO_DURACAO_REFERENCIA_S=180
# Mediana de views minima para uma conta candidata do pesquisa-de-setor "ter alcance" (M2).
ALCANCE_MINIMO_CONTA_SETOR=5000
# Teto diario de analise de video sem fala (quadros + legenda), so para setor que aceita isso (M3).
ANALISE_SEM_FALA_POR_DIA=15
# E38 PR 2, "o que entendemos da sua marca" (leitura do site e das redes da propria marca):
# idade, em dias, da ultima leitura boa para o despachante diario ler de novo.
DIAS_ENTRE_LEITURAS_MARCA=30
# Quantas marcas o despachante enfileira por rodada (o resto fica para o dia seguinte).
LEITURAS_MARCA_POR_RODADA=25
# Teto de custo de IA da tarefa por mes, em dolares, somado de geracoes_ia.
TETO_CUSTO_LEITURA_MARCA_MES_USD=5
# Minutos minimos entre duas leituras disparadas por evento (a pessoa salvou o site ou um perfil).
MINUTOS_ENTRE_LEITURAS_MARCA_EVENTO=10
# Quantas chamadas de IA da leitura da marca uma marca gasta por dia (o freio por marca).
CHAMADAS_IA_MARCA_POR_DIA=6
# 0 segura o despachante diario da leitura (a primeira rodada le, sozinha, toda marca ativa ainda nao lida);
# a leitura quando a pessoa salva o site ou um perfil continua.
LEITURA_MARCA_DESPACHO=1
